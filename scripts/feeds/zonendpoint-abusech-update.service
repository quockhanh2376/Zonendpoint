[Unit]
Description=Zonendpoint Hourly abuse.ch (MalwareBazaar + ThreatFox) Feed Update
Documentation=https://bazaar.abuse.ch/ https://threatfox.abuse.ch/
After=network-online.target clamav-daemon.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/bin/zonendpoint-abusech-update.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zonendpoint-abusech-update
TimeoutStartSec=600

# Sandbox & Security Hardening (Task L-12 / V-62)
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectSystem=strict
ReadWritePaths=/opt/zonendpoint /var/lib/clamav /var/backups/clamav-malwarebazaar /var/backups/clamav-threatfox /run/lock
ReadOnlyPaths=/etc/zonendpoint
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
