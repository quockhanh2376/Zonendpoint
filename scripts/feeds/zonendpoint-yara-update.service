[Unit]
Description=Zonendpoint Daily YARA-Forge Core Feed Update
Documentation=https://github.com/YARAHQ/yara-forge
After=network-online.target clamav-daemon.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/bin/zonendpoint-yara-update.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zonendpoint-yara-update
TimeoutStartSec=600

# Sandbox & Security Hardening (Task L-12 / V-62)
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectSystem=strict
ReadWritePaths=/opt/zonendpoint /var/lib/clamav /var/backups/clamav-yara /run/lock
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
