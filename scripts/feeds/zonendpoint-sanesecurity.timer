[Unit]
Description=Zonendpoint Sanesecurity Signature Feed Update Timer
Documentation=https://sanesecurity.com/

[Timer]
# Fires every 2 hours with 15 minutes randomized delay
OnCalendar=*-*-* 00,02,04,06,08,10,12,14,16,18,20,22:00:00
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
